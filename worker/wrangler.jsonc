{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bk-study-library-upload",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  // Tắt nhật ký mỗi lượt gọi vì nó ghi cả IP người gửi (spec: IP không ghi log).
  // Vẫn giữ console.error của Worker, chỉ chứa bước và mã lỗi.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  // Tên miền riêng: Cloudflare Access chỉ bảo vệ được /xem-duyet/* trên tên miền thuộc tài khoản.
  // workers.dev vẫn bật trong lúc chuyển; ở đó /xem-duyet/* không qua Access nhưng Worker vẫn tự kiểm JWT.
  "routes": [
    { "pattern": "upload.xerozsoft.com", "custom_domain": true }
  ],
  "workers_dev": true,
  // Giá trị có thể đổi khi chuyển repo hay tên miền. Khóa bí mật nhập bằng wrangler secret put:
  // TURNSTILE_SECRET, GH_APP_ID, GH_APP_PRIVATE_KEY, GH_INSTALLATION_ID.
  "vars": {
    "REPO": "bk-study-library/hcmut-library",
    "BRANCH": "main",
    "ALLOWED_ORIGINS": "https://bk-study-library.github.io",
    "CATALOG_TTL_SECONDS": "300",
    // "true" khi repo public: trả link PR cho người gửi theo dõi bài.
    "PUBLIC_PR_LINKS": "true",
    // Gốc địa chỉ xem file: link cho người duyệt (/xem-duyet/<mã>) và người gửi (/xem/<mã>?k=...).
    // Để trống thì không tạo link xem bài.
    "REVIEW_BASE": "https://upload.xerozsoft.com",
    // Gốc web thư viện (có / cuối): /xem-truoc chỉ nhận file .md nằm ở <SITE_BASE>files/<ID môn>/.
    "SITE_BASE": "https://bk-study-library.github.io/hcmut-library/",
    // Cloudflare Access cho /xem-duyet/*: tên miền team (dạng <team>.cloudflareaccess.com) và
    // Application Audience (AUD). Để trống thì /xem-duyet/* trả 503.
    "ACCESS_TEAM_DOMAIN": "tktq40.cloudflareaccess.com",
    "ACCESS_AUD": "d9150868f1e48b3f2e36ffcf80e20b05fb1fb83bdc067f95ef75829ad1c021ee"
  },
  // Kho cách ly: file chờ duyệt, riêng tư.
  "r2_buckets": [
    { "binding": "QUARANTINE", "bucket_name": "bk-lib-quarantine" }
  ],
  // Giới hạn số lần gửi theo IP: 5 lần mỗi 60 giây.
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
