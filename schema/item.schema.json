{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bk-study-library/hcmut-library/schema/item.schema.json",
  "title": "Item",
  "description": "Một tài liệu hoặc link của một môn. / One resource or link for a course.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "course", "type", "title", "lang", "license", "origin", "added", "removed"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "course": { "type": "string", "pattern": "^[A-Z0-9_]{3,12}(-[0-9]{4})?$" },
    "type": {
      "enum": ["lecture-slides", "summary", "notes", "cheatsheet", "quiz-pack", "tips", "link", "exercise-solution", "exam-solution", "exam-past", "prelab-template", "prelab-reference", "lab-report-reference", "project-reference", "book-ref"],
      "description": "Đủ danh sách của hợp đồng v1. Loại nào đang nhận thì xem catalog/policy.json (openTypes)."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 1000 },
    "lang": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "term": { "type": "string", "pattern": "^HK[0-9]{3}$" },
    "teacher": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Tên giảng viên như trên thời khóa biểu. Không chấm điểm hay nhận xét giảng viên." },
    "examKind": { "enum": ["gk", "ck", "quiz", "kt"], "description": "Giữa kỳ, cuối kỳ, quiz, kiểm tra." },
    "chapter": { "type": "string", "pattern": "^[0-9A-Za-z.-]{1,20}$", "description": "Chương hoặc bài, ví dụ 3 hay 3.2." },
    "lab": { "type": ["integer", "string"] },
    "authors": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "license": { "type": "string", "minLength": 1, "description": "SPDX, ví dụ CC-BY-SA-4.0. Với link: giấy phép của nguồn." },
    "origin": { "type": "string", "pattern": "^(self-made|link|partner:[a-z0-9-]+)$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[^/\\\\]+\\.[A-Za-z0-9]+$" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "url": { "type": "string", "pattern": "^https://" },
          "mirrors": { "type": "array", "items": { "type": "string", "pattern": "^https://" }, "description": "Link dự phòng của cùng file (cùng sha256)." },
          "path": { "type": "string", "pattern": "^files/[^/\\\\]+\\.md$", "description": "File .md nhỏ nằm trong git, đường dẫn tính từ thư mục môn." },
          "mime": { "type": "string", "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$", "description": "Loại nội dung của file. Không có thì lấy theo đuôi trong catalog/policy.json." },
          "quarantine": { "type": "string", "pattern": "^(pending|clean)/[A-Za-z0-9]{10}/[^/]+$", "description": "Chỗ file nằm trong kho cách ly khi chưa có url. Chỉ dùng nội bộ, không ra v1." },
          "uploadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 của file gốc người gửi tải lên, trước khi làm sạch. Worker dùng để chặn gửi trùng. Chỉ dùng nội bộ, không ra v1." }
        }
      }
    },
    "url": { "type": "string", "pattern": "^https://" },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authors"],
      "description": "Chỉ cho type book-ref: thông tin sách, không kèm file.",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "authors": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "year": { "type": "integer", "minimum": 1000, "maximum": 2100 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 120 },
        "isbn": { "type": "string", "pattern": "^(97[89][0-9]{10}|[0-9]{9}[0-9X])$" }
      }
    },
    "source": { "type": "string", "description": "Tên nguồn của link, ví dụ OpenStax." },
    "example": { "type": "boolean", "description": "Mục mẫu để minh họa định dạng." },
    "added": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Ngày file của mục đổi lần gần nhất. Không có thì coi như bằng added." },
    "removed": { "type": "boolean" },
    "removedReason": { "type": "string", "minLength": 1 },
    "replaces": { "type": "string", "pattern": "^[A-Z0-9_]{3,12}(-[0-9]{4})?/[a-z0-9][a-z0-9-]*$", "description": "Bản cập nhật: <ID môn>/<id tài liệu> được thay. Tài liệu cũ được ẩn như đã gỡ khi mục này còn hiệu lực." },
    "unclassified": { "type": "array", "minItems": 1, "items": { "enum": ["new-course", "pii", "no-text", "warning", "duplicate", "update"] }, "description": "Đăng tự động nhưng chưa chắc (scripts/upload/triage.mjs): lý do để người duyệt xử lý ở trang chua-phan-loai/. Xử lý xong thì bỏ trường này." },
    "gradedAfter": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
