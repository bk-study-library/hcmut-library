{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bk-study-library/hcmut-library/schema/faculty.schema.json",
  "title": "Faculties",
  "description": "Khoa/ngành và gợi ý tiền tố mã môn. / Faculties or majors and course-code prefix hints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["faculties", "prefixes"],
  "properties": {
    "$schema": { "type": "string" },
    "faculties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vi", "en"],
            "properties": { "vi": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
          },
          "note": { "type": "string" },
          "movedTo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Khóa cũ chỉ giữ để link không hỏng: không có môn, chương trình, ngành; không hiện trong danh sách khoa; trang khoa chuyển tới khoa này. / Legacy key kept for old links only."
          }
        }
      }
    },
    "prefixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "faculty", "verified"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1, "description": "Biểu thức chính quy (regex) khớp cả mã môn." },
          "faculty": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "verified": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
